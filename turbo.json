{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "HARDHAT_DISABLE_TELEMETRY"
  ],
  "tasks": {
    "test": { "cache": false, "dependsOn": ["build"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build"]
    },
    "clean": { "cache": false },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "dist": { "dependsOn": ["^build"] }
  }
}
