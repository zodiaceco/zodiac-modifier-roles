{
  "name": "zodiac-roles-sdk",
  "version": "4.1.3",
  "license": "LGPL-3.0+",
  "description": "A library for managing role permissions on Zodiac Roles Modifier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnosisguild/zodiac-modifier-roles.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/gnosisguild/zodiac-modifier-roles/tree/main/packages/sdk",
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.js"
    },
    "./annotations": {
      "import": "./build/annotations.mjs",
      "require": "./build/annotations.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./build/index.d.ts"
      ],
      "annotations": [
        "./build/annotations.d.ts"
      ]
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn check:types && yarn check:prettier",
    "check:types": "tsc --noEmit",
    "check:prettier": "prettier \"src/**/*.ts\" --list-different",
    "fix": "yarn fix:prettier",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "pre-commit": "yarn fix"
  },
  "dependencies": {
    "abitype": "^1.0.8",
    "ethers": "^6.16.0"
  },
  "peerDependencies": {
    "openapi-backend": "^5.15.0",
    "openapi-types": "^12.1.3"
  },
  "peerDependenciesMeta": {
    "openapi-backend": {
      "optional": true
    },
    "openapi-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gnosis-guild/zodiac-core-modifier-roles": "workspace:*",
    "@types/node": "^24.19.2",
    "openapi-backend": "^5.15.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "tsdown": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
